# Nexus ASM Backend Configuration

# Database
DATABASE_URL=sqlite+aiosqlite:///./nexus.db

# Security (Generate a random string for JWT)
SECRET_KEY=change_this_to_a_secure_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Facebook Graph API
FB_APP_ID=
FB_APP_SECRET=

# AI Prodviders
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Storage (HuggingFace/Cloudflare)
HF_TOKEN=
HF_REPO=
